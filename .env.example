# Web (build-time). For production set this to the Cloudflare tunnel HTTPS URL.
VITE_API_BASE_URL=http://localhost:3000
# Web (build-time). GitHub Pages subpath, with leading + trailing slash.
# Leave as "/" for local dev or a custom-domain/root deploy.
VITE_BASE_PATH=/

# Server
ADMIN_PIN=change-me-admin
LEAGUE_PIN=change-me-league
