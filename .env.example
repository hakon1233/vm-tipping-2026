# Web (build-time). For production set this to the Cloudflare tunnel HTTPS URL.
VITE_API_BASE_URL=http://localhost:3000
# Web (build-time). GitHub Pages subpath, with leading + trailing slash.
# Leave as "/" for local dev or a custom-domain/root deploy.
VITE_BASE_PATH=/

# Server
ADMIN_PIN=change-me-admin
LEAGUE_PIN=change-me-league
# Optional: where the SQLite file lives (default data/vm-tipping.sqlite)
# DATABASE_PATH=data/vm-tipping.sqlite
# PORT=3000
# Optional: set to 1 to lift the group/knockout pick deadlines, so picks stay
# editable after kickoff. The flag is reported on /api/matches so the web UI
# unlocks too. Unset it and restart the server to re-enable deadline locking.
# DEADLINES_DISABLED=1
