# Copy to .env. The values below run a local demo; set your own for a real league.

# --- Server ---
# Required: the API refuses to start without both PINs.
ADMIN_PIN=demo-admin
LEAGUE_PIN=demo-league
# Web origins allowed to call the API from a browser (comma-separated).
# Local dev serves the web app on :5173; in production use the Pages origin.
CORS_ORIGIN=http://localhost:5173
# The 2026 deadlines have passed, so the demo lifts them to keep picks editable.
# Remove this line (and restart the server) to lock picks at the deadlines again.
DEADLINES_DISABLED=1
# Optional:
# PORT=3000
# DATABASE_PATH=data/vm-tipping.sqlite

# --- Web (read at build time) ---
# The API URL baked into the bundle as a fallback; a deployed site reads the
# current one from config.json at runtime (see ops/README.md).
VITE_API_BASE_URL=http://localhost:3000
# Pages subpath with leading and trailing slash, e.g. /vm-tipping-2026-web/.
# Read from the environment by vite.config.ts (the deploy workflow sets it).
# VITE_BASE_PATH=/
