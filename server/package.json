{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "build": "tsc -b",
    "start": "node --env-file=../.env dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p test",
    "seed:demo": "tsx --env-file-if-exists=../.env scripts/seed-demo.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@vm-tipping-2026/shared": "^0.1.0",
    "exceljs": "^4.4.0",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "vitest": "^4.0.15"
  }
}
